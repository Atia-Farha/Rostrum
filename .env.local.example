# Application
APP_NAME=Rostrum
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
ASSET_URL=
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

# Security and logging
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_LEVEL=debug

# Database
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
DB_FOREIGN_KEYS=true

# Session, cache, queue, and storage
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true
CACHE_STORE=database
CACHE_PREFIX=rostrum
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# Mail
MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Groq AI reasoning and speech-to-text
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_REASONING_MODEL=openai/gpt-oss-120b
GROQ_REASONING_FALLBACK_MODEL_1=qwen/qwen3.8-27b
GROQ_REASONING_FALLBACK_MODEL_2=openai/gpt-oss-20b
GROQ_REASONING_TIMEOUT=60
GROQ_STT_MODEL=whisper-large-v3
GROQ_STT_FALLBACK_MODEL=whisper-large-v3-turbo
GROQ_STT_TIMEOUT=60

# ElevenLabs speech-to-text fallback
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v3
ELEVENLABS_STT_TIMEOUT=60

# Gemini text-to-speech
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_TIMEOUT=45
GEMINI_TTS_VOICE_EN=Kore
GEMINI_TTS_VOICE_BN=Kore

# Edge text-to-speech fallback
EDGE_TTS_BINARY=edge-tts
EDGE_TTS_TIMEOUT=45
EDGE_TTS_VOICE_EN=en-US-AvaMultilingualNeural
EDGE_TTS_VOICE_BN=bn-BD-NabanitaNeural

# Optional demo account
SEED_ACCOUNT_NAME="Demo Debater"
SEED_ACCOUNT_EMAIL=demo@rostrum.app
SEED_ACCOUNT_PASSWORD=rostrum-demo
